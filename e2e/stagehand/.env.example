# Copia este archivo como .env (nunca se commitea).

# Créditos (Andrés): Model Routing con Gemini
GEMINI_API_KEY=

# Bolsillos y Depositar (Alejandro): Claude
ANTHROPIC_API_KEY=
# Opcional: otro modelo de Anthropic, p. ej. anthropic/claude-haiku-5-5 (más barato),
# o Gemini con la capa gratuita: STAGEHAND_MODEL=google/gemini-2.5-flash (usa GEMINI_API_KEY)
STAGEHAND_MODEL=anthropic/claude-sonnet-5-5

# Sistema bajo prueba
BASE_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1
HEADLESS=false
