{
  "name": "fubanking-sonar-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "FuBanking - scripts raiz para CI local y sustentacion + analisis SonarQube.",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "sonar": "sonar-scanner",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:coverage": "npm --prefix backend run test:coverage && npm --prefix frontend run test:coverage",
    "test:regression": "sh scripts/regression.sh",
    "test:regression:backend": "sh scripts/regression.sh backend",
    "test:regression:frontend": "sh scripts/regression.sh frontend",
    "test:regression:loans": "sh scripts/regression.sh loans",
    "test:api": "npm --prefix backend run test:api",
    "test:performance": "npm --prefix backend run test:performance",
    "test:load:k6": "k6 run scripts/performance/loans-load.js",
    "test:serenity": "npm --prefix e2e/serenity test",
    "test:serenity:report": "npm --prefix e2e/serenity run test:report",
    "test:serenity:creditos": "npm --prefix e2e/serenity run test:creditos",
    "test:e2e:serenity": "npm --prefix e2e/serenity test",
    "test:e2e:serenity:report": "npm --prefix e2e/serenity run test:report",
    "test:report": "npm --prefix e2e/serenity run test:report",
    "test:e2e:vitest": "npx --prefix backend vitest run --config e2e/vitest/vitest.config.e2e.mts",
    "test:e2e:seed": "node e2e/serenity/scripts/seed-users.mjs",
    "test:e2e:clean": "node backend/scripts/clean-e2e-users.mjs",
    "katalon:seed": "node katalon/scripts/seed-usuarios.mjs",
    "katalon:generar": "node katalon/scripts/generar-casos.mjs",
    "katalon:integrar": "node katalon/scripts/integrar-tests.mjs",
    "cypress:open": "npx cypress open",
    "cypress:run": "npx cypress run",
    "test:cypress": "npx cypress run",
    "test:cypress:loans": "npx cypress run --spec \"cypress/e2e/**/*.cy.ts\"",
    "test:cypress:report": "npx mochawesome-merge \"cypress/reports/mochawesome/*.json\" -o cypress/reports/merged-report.json && npx marge cypress/reports/merged-report.json -f index -o cypress/reports/html",
    "cypress:report": "npx mochawesome-merge \"cypress/reports/mochawesome/*.json\" -o cypress/reports/merged-report.json && npx marge cypress/reports/merged-report.json -f index -o cypress/reports/html",
    "test:cypress:regression": "npx cypress run --spec \"cypress/e2e/regression/*.cy.ts\"",
    "test:cypress:api": "npx cypress run --spec \"cypress/e2e/api/*.cy.ts\"",
    "test:cypress:security": "npx cypress run --spec \"cypress/e2e/security/*.cy.ts\"",
    "test:cypress:ui": "npx cypress run --spec \"cypress/e2e/ui/*.cy.ts\"",
    "test:cypress:a11y": "npx cypress run --spec \"cypress/e2e/accessibility/*.cy.ts\"",
    "test:cypress:auth": "npx cypress run --spec \"cypress/e2e/auth/*.cy.ts\"",
    "test:cypress:profile": "npx cypress run --spec \"cypress/e2e/profile/*.cy.ts\"",
    "test:cypress:accounts": "npx cypress run --spec \"cypress/e2e/accounts/*.cy.ts\"",
    "test:cypress:e2e": "npx cypress run --spec \"cypress/e2e/{auth,profile,accounts}/*.cy.ts\"",
    "test:stagehand": "npm --prefix e2e/stagehand test",
    "test:stagehand:headed": "npm --prefix e2e/stagehand run test:headed",
    "test:stagehand:login": "npm --prefix e2e/stagehand run test:login",
    "test:stagehand:login2fa": "npm --prefix e2e/stagehand run test:login2fa",
    "test:stagehand:registro": "npm --prefix e2e/stagehand run test:registro",
    "test:stagehand:perfil": "npm --prefix e2e/stagehand run test:perfil",
    "test:stagehand:contrasena": "npm --prefix e2e/stagehand run test:contrasena",
    "test:stagehand:retiro": "npm --prefix e2e/stagehand run test:retiro",
    "test:stagehand:simulate": "npm --prefix e2e/stagehand run test:simulate",
    "test:stagehand:requirements": "npm --prefix e2e/stagehand run test:requirements",
    "test:stagehand:admin": "npm --prefix e2e/stagehand run test:admin",
    "test:mcp:playwright": "npx tsx test/pruebas-herramientas/herramientas-bedoya/01-mcp-playwright/runner/loans-mcp.test.ts",
    "test:cypress:cloud": "cypress run --config-file test/pruebas-herramientas/herramientas-bedoya/02-cypress-cloud-ai/cypress.cloud.config.ts --record --key ac573719-2fc7-4b3f-b0d7-af3d816c659c",
    "test:cypress:studio": "cypress open --config-file test/pruebas-herramientas/herramientas-bedoya/02-cypress-cloud-ai/cypress.cloud.config.ts",
    "test:rp:cypress": "node test/pruebas-herramientas/herramientas-bedoya/03-reportportal/cypress-agent/run-cypress-rp.mjs",
    "test:rp:playwright": "node test/pruebas-herramientas/herramientas-bedoya/03-reportportal/playwright-agent/run-playwright-rp.mjs",
    "test:herramientas:all": "powershell -ExecutionPolicy Bypass -File test/pruebas-herramientas/herramientas-bedoya/scripts/run-all-herramientas.ps1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.1",
    "@reportportal/agent-js-cypress": "^5.5.4",
    "@reportportal/agent-js-playwright": "^5.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "dotenv": "^18.0.9",
    "jsonwebtoken": "^9.0.3",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "sonarqube-scanner": "^4.2.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
