{
  "id": "fubanking-login-suite",
  "version": "3.0",
  "name": "Suite_09_Login",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "cp01-login-exitoso",
      "name": "CP01_Login_Exitoso",
      "commands": [
        {
          "command": "open",
          "target": "http://localhost:3000/login",
          "value": ""
        },
        {
          "command": "runScript",
          "target": "localStorage.clear(); sessionStorage.clear(); document.cookie = \"token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT\";",
          "value": ""
        },
        {
          "command": "pause",
          "target": "500",
          "value": ""
        },
        {
          "command": "waitForElementPresent",
          "target": "id=email",
          "value": "5000"
        },
        {
          "command": "runScript",
          "target": "const input = document.getElementById('email'); const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeSetter.call(input, 'Pruebaskatalon@gmail.com'); input.dispatchEvent(new Event('input', { bubbles: true })); input.dispatchEvent(new Event('change', { bubbles: true }));",
          "value": ""
        },
        {
          "command": "pause",
          "target": "500",
          "value": ""
        },
        {
          "command": "waitForElementPresent",
          "target": "id=password",
          "value": "5000"
        },
        {
          "command": "runScript",
          "target": "const input = document.getElementById('password'); const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeSetter.call(input, 'Katalon123.'); input.dispatchEvent(new Event('input', { bubbles: true })); input.dispatchEvent(new Event('change', { bubbles: true }));",
          "value": ""
        },
        {
          "command": "pause",
          "target": "500",
          "value": ""
        },
        {
          "command": "click",
          "target": "css=button[type=\"submit\"]",
          "value": ""
        },
        {
          "command": "pause",
          "target": "3000",
          "value": ""
        },
        {
          "command": "assertNotLocation",
          "target": "http://localhost:3000/login",
          "value": ""
        }
      ]
    },
