{
  "name": "banco-digital-backend",
  "version": "1.0.0",
  "description": "Backend del Banco Digital - Módulo de Gestión de Usuarios",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:loans": "vitest run src/tests/unit/loan src/tests/regression src/tests/security src/tests/performance",
    "test:regression": "vitest run src/tests/regression",
    "test:security": "vitest run src/tests/security",
    "test:performance": "vitest run src/tests/performance",
    "test:regression:bolsillos": "vitest run src/tests/regression/pocket src/tests/regression/account src/tests/unit/pocket src/tests/unit/account/DepositMoney.test.ts",
    "test:performance:bolsillos": "vitest run src/tests/performance/pocket --reporter=verbose",
    "test:security:bolsillos": "vitest run src/tests/security/pocket --reporter=verbose",
    "test:api": "vitest run src/tests/api"
  },
  "keywords": [
    "bank",
    "nodejs",
    "express",
    "typescript",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@assertive-ts/core": "^2.1.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^12.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  }
}
