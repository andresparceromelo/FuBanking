# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# 2FA — Token temporal emitido en el primer paso del login con 2FA activo.
# Debe ser suficientemente largo para absorber la latencia del correo electrónico.
# Formato: duración compatible con jsonwebtoken (ej. '10m', '15m').
TWO_FACTOR_TOKEN_EXPIRES_IN=10m

# Rate Limiting — Endpoint POST /auth/2fa/resend
# Número máximo de reenvíos permitidos por ventana de tiempo (por token/IP).
RESEND_RATE_LIMIT_MAX=3
# Duración de la ventana de rate limiting en milisegundos (600000 = 10 minutos).
RESEND_RATE_LIMIT_WINDOW_MS=600000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

GMAIL_USSER=tu_correo@gmail.com
GMAIL_PASS=tu_contraseña_de_aplicacion
